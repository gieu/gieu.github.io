---
import BaseLayout from "../layouts/BaseLayout.astro";
import Pagination from "../components/Pagination.astro";
import { getCollection } from "astro:content";
import {
  SCIENTI_URL,
  obtenerSeccionesScienti,
} from "./api/publicaciones.json.ts";
import type { Publicacion as PublicacionApi } from "./api/publicaciones.json.ts";

const catalogoScienti = await obtenerSeccionesScienti();
const usandoRespaldo = catalogoScienti.publicaciones.length === 0;
const publicaciones: PublicacionApi[] = usandoRespaldo
  ? (await getCollection("researchs")).map(({ data }, index) => ({
      numero: String(index + 1),
      titulo: data.title,
      revista: data.journal,
      editorial: data.publisher,
      anio: String(data.year),
      autores: data.author.join("; "),
      doi: data.DOI ?? null,
      url: data.url,
    }))
  : catalogoScienti.publicaciones;

const publicacionesOrdenadas = [...publicaciones].sort(
  (a, b) => Number(b.anio ?? 0) - Number(a.anio ?? 0)
);
const publicacionesPorPagina = 6;
const totalPaginas = Math.max(1, Math.ceil(publicacionesOrdenadas.length / publicacionesPorPagina));
const paginaSolicitada = Number(Astro.url.searchParams.get("pagina") ?? "1");
const paginaActual = Number.isSafeInteger(paginaSolicitada)
  ? Math.min(Math.max(paginaSolicitada, 1), totalPaginas)
  : 1;
const inicioPublicaciones = (paginaActual - 1) * publicacionesPorPagina;
const publicacionesEnPagina = publicacionesOrdenadas.slice(
  inicioPublicaciones,
  inicioPublicaciones + publicacionesPorPagina
);
const enlacePagina = (parametro: string, pagina: number, seccion: string) => {
  const parametros = new URLSearchParams(Astro.url.searchParams);
  if (pagina === 1) parametros.delete(parametro);
  else parametros.set(parametro, String(pagina));
  const consulta = parametros.toString();
  const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
  const pathname = Astro.url.pathname.startsWith(`${basePath}/`) || Astro.url.pathname === basePath
    ? Astro.url.pathname
    : `${basePath}${Astro.url.pathname.startsWith("/") ? "" : "/"}${Astro.url.pathname}`;
  return `${pathname}${consulta ? `?${consulta}` : ""}#${seccion}`;
};

// Mapeamos al modelo que usa la UI de tarjetas.
const investigaciones = publicacionesEnPagina.map((pub) => ({
  titulo: pub.titulo,
  categoria: pub.revista || "Publicación Scienti",
  año_inicio: pub.anio ?? "Sin año",
  descripcion: pub.autores ? `Autores: ${pub.autores}` : "Autores no disponibles",
  tecnologias: [pub.revista, pub.editorial].filter(Boolean) as string[],
  esBusqueda: !pub.doi && (!pub.url || pub.url === SCIENTI_URL),
  url_detalles: pub.doi
    ? pub.url ?? `https://doi.org/${pub.doi}`
    : pub.url && pub.url !== SCIENTI_URL
      ? pub.url
      : `https://scholar.google.com/scholar?q=${encodeURIComponent(pub.titulo)}`,
  doi: pub.doi,
}));

const configuracionProductos = [
  { key: "software", parametro: "software", titulo: "Software producido", categoria: "Software", tipo: "software", icono: "💻" },
  { key: "capitulosLibro", parametro: "capitulos", titulo: "Capítulos de libros publicados", categoria: "Capítulo de libro", tipo: "capitulo", icono: "📖" },
  { key: "librosPublicados", parametro: "libros", titulo: "Libros publicados", categoria: "Libro", tipo: "libro", icono: "📚" },
  { key: "librosFormacion", parametro: "formacion", titulo: "Libros de formación", categoria: "Libro de formación", tipo: "libro", icono: "📚" },
  { key: "librosDivulgacion", parametro: "divulgacion", titulo: "Libros de divulgación y/o compilación", categoria: "Libro de divulgación", tipo: "libro", icono: "📚" },
  { key: "otrosProductosTecnologicos", parametro: "tecnologicos", titulo: "Otros productos tecnológicos", categoria: "Producto tecnológico", tipo: "tecnologico", icono: "🧩" },
] as const;

const productosScienti = configuracionProductos.map((configuracion) => {
  const todos = [...catalogoScienti[configuracion.key]].sort(
    (a, b) => Number(b.anio ?? 0) - Number(a.anio ?? 0)
  );
  const totalPaginas = Math.max(1, Math.ceil(todos.length / publicacionesPorPagina));
  const paginaSolicitada = Number(Astro.url.searchParams.get(configuracion.parametro) ?? "1");
  const paginaActual = Number.isSafeInteger(paginaSolicitada)
    ? Math.min(Math.max(paginaSolicitada, 1), totalPaginas)
    : 1;
  const inicio = (paginaActual - 1) * publicacionesPorPagina;
  const items = todos.slice(inicio, inicio + publicacionesPorPagina).map((item) => {
    const busqueda = configuracion.tipo === "software" || configuracion.tipo === "tecnologico"
      ? `https://www.google.com/search?q=${encodeURIComponent(item.titulo)}`
      : configuracion.tipo === "libro" && item.isbn
        ? `https://books.google.com/books?q=isbn%3A${encodeURIComponent(item.isbn)}`
        : `https://scholar.google.com/scholar?q=${encodeURIComponent(item.titulo)}`;
    const textoEnlace = item.doi
      ? "Abrir publicación"
      : item.sitioWeb
        ? "Abrir sitio web"
        : configuracion.tipo === "software"
          ? "Buscar software"
          : configuracion.tipo === "tecnologico"
            ? "Buscar producto"
            : configuracion.tipo === "capitulo"
              ? "Buscar capítulo"
              : "Buscar libro";

    return {
      titulo: item.titulo,
      anio: item.anio ?? "Sin año",
      autores: item.autores,
      detalle: item.detalle,
      doi: item.doi,
      url: item.url ?? busqueda,
      textoEnlace,
    };
  });

  return { ...configuracion, total: todos.length, totalPaginas, paginaActual, inicio, items };
});

---

<BaseLayout title="GIEU - Investigación" description="Conoce las líneas de investigación, publicaciones y productos académicos del Grupo de Investigación en Informática Educativa de la Universidad del Norte.">
    <style>
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }
        
        @keyframes floatReverse {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(20px); }
        }
        
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        @keyframes slideInLeft {
            from {
                opacity: 0;
                transform: translateX(-50px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }
        
        @keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(50px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }
        
        @keyframes scaleIn {
            from {
                opacity: 0;
                transform: scale(0.8);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }
        
        .results-grid.results-enter {
            animation: resultsEnter 0.28s ease-out both;
        }

        @keyframes resultsEnter {
            from { opacity: 0.5; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .area-card {
            animation: scaleIn 0.8s ease-out forwards;
            opacity: 0;
        }
        
        .area-card:nth-child(1) { animation-delay: 0.2s; }
        .area-card:nth-child(2) { animation-delay: 0.4s; }
        .area-card:nth-child(3) { animation-delay: 0.6s; }
        
        .hero-title {
            animation: fadeInUp 1s ease-out;
        }
        
        .hero-subtitle {
            animation: fadeInUp 1s ease-out 0.3s both;
        }
        
        .floating-bg {
            animation: float 6s ease-in-out infinite;
        }
        
        .floating-bg-reverse {
            animation: floatReverse 8s ease-in-out infinite;
        }
        
        .glass-morphism {
            backdrop-filter: blur(10px);
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        
        .research-hover {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .research-hover:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        }
        
        .tech-badge {
            transition: all 0.3s ease;
        }
        
        .tech-badge:hover {
            transform: scale(1.1);
        }
        
        .floating-element {
            animation: float 6s ease-in-out infinite;
        }
        
        .animate-fade-in-up {
            animation: fadeInUp 0.8s ease-out forwards;
        }

        @media (prefers-reduced-motion: reduce) {
            .research-page * {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }

            .area-card, .hero-title, .hero-subtitle,
            .floating-bg, .floating-bg-reverse, .floating-element,
            .animate-fade-in-up {
                animation: none !important;
                opacity: 1 !important;
            }

            .research-hover, .area-card, .tech-badge {
                transition: none !important;
            }

            .research-hover:hover, .area-card:hover, .tech-badge:hover {
                transform: none !important;
            }
        }
    </style>

    <main class="research-page min-h-screen relative overflow-hidden">
        <!-- Floating Background Elements -->
        <div class="fixed inset-0 overflow-hidden pointer-events-none z-0">
            <div class="floating-bg absolute top-20 left-10 w-32 h-32 bg-daisy_bush-300 opacity-10 rounded-full blur-xl"></div>
            <div class="floating-bg-reverse absolute top-40 right-20 w-48 h-48 bg-Shiraz-400 opacity-8 rounded-full blur-2xl"></div>
            <div class="floating-bg absolute bottom-32 left-1/4 w-40 h-40 bg-daisy_bush-200 opacity-12 rounded-full blur-xl"></div>
            <div class="floating-bg-reverse absolute top-1/3 right-1/3 w-24 h-24 bg-Shiraz-300 opacity-15 rounded-full blur-lg"></div>
            <div class="floating-bg absolute bottom-20 right-16 w-36 h-36 bg-daisy_bush-400 opacity-10 rounded-full blur-xl"></div>
        </div>

        <!-- Hero Section -->
        <section class="relative bg-gradient-to-br from-daisy_bush-900 via-daisy_bush-800 to-Shiraz-900 text-cod_gray-50 py-20 z-10">
            <div class="max-w-[1140px] mx-auto px-10 text-center relative">
                <!-- Glass morphism decoration -->
                <div class="glass-morphism absolute -top-10 -left-10 w-24 h-24 rounded-full opacity-30"></div>
                <div class="glass-morphism absolute -bottom-8 -right-12 w-32 h-32 rounded-full opacity-20"></div>
                
                <h1 class="hero-title text-4xl md:text-5xl font-bold mb-6">
                    Nuestras <span class="text-daisy_bush-300">Investigaciones</span>
                </h1>
                <p class="hero-subtitle text-xl md:text-2xl mb-8 leading-relaxed max-w-3xl mx-auto">
                    Desarrollamos investigación de vanguardia en educación STEM, 
                    tecnología educativa e inclusión para transformar la enseñanza y el aprendizaje.
                </p>
            </div>
        </section>

        <!-- Research Areas -->
        <section class="relative bg-gradient-to-br from-cod_gray-50 to-cod_gray-100 py-20 z-10">
            <div class="max-w-[1140px] mx-auto px-10 relative">
                <h2 class="text-3xl font-semibold text-center mb-12 text-cod_gray-900 hero-title">
                    Líneas de Investigación
                </h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
                    <!-- Research Area 1 -->
                    <div class="area-card bg-white/80 backdrop-blur-sm p-8 rounded-xl shadow-lg hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 border border-white/20">
                        <div class="text-5xl mb-6 text-center transform hover:scale-110 transition-transform duration-300">🔬</div>
                        <h3 class="text-xl font-semibold mb-4 text-cod_gray-900 text-center">
                            Metodologías STEM
                        </h3>
                        <p class="text-cod_gray-700 text-center leading-relaxed">
                            Desarrollo de enfoques pedagógicos innovadores para la enseñanza 
                            integrada de ciencias, tecnología, ingeniería y matemáticas.
                        </p>
                    </div>

                    <!-- Research Area 2 -->
                    <div class="area-card bg-white/80 backdrop-blur-sm p-8 rounded-xl shadow-lg hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 border border-white/20">
                        <div class="text-5xl mb-6 text-center transform hover:scale-110 transition-transform duration-300">💻</div>
                        <h3 class="text-xl font-semibold mb-4 text-cod_gray-900 text-center">
                            Tecnología Educativa
                        </h3>
                        <p class="text-cod_gray-700 text-center leading-relaxed">
                            Investigación en el uso efectivo de tecnologías emergentes 
                            para mejorar los procesos de enseñanza-aprendizaje.
                        </p>
                    </div>

                    <!-- Research Area 3 -->
                    <div class="area-card bg-white/80 backdrop-blur-sm p-8 rounded-xl shadow-lg hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 border border-white/20">
                        <div class="text-5xl mb-6 text-center transform hover:scale-110 transition-transform duration-300">🎯</div>
                        <h3 class="text-xl font-semibold mb-4 text-cod_gray-900 text-center">
                            Inclusión y Equidad
                        </h3>
                        <p class="text-cod_gray-700 text-center leading-relaxed">
                            Estudios sobre estrategias para promover la participación 
                            equitativa en la educación STEM.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Research Projects -->
        <section id="publicaciones" class="relative bg-gradient-to-br from-cod_gray-100 to-cod_gray-200 py-20 z-10 scroll-mt-24">
            <div class="max-w-[1140px] mx-auto px-10 relative">
                <!-- Decorative elements -->
                <div class="absolute top-10 right-10 w-20 h-20 bg-daisy_bush-200 opacity-20 rounded-full blur-xl floating-bg"></div>
                <div class="absolute bottom-10 left-10 w-16 h-16 bg-Shiraz-200 opacity-25 rounded-full blur-lg floating-bg-reverse"></div>
                
                <h2 class="text-3xl font-semibold text-center mb-12 text-cod_gray-900 hero-title">
                    Publicaciones
                </h2>

                {usandoRespaldo && (
                    <p class="text-center text-cod_gray-700 mb-8" role="status">
                        Estamos mostrando las publicaciones guardadas mientras se restablece la consulta a Scienti.
                    </p>
                )}

                <p class="text-center text-cod_gray-700 mb-8">
                    Mostrando {publicaciones.length === 0 ? 0 : inicioPublicaciones + 1}–{Math.min(inicioPublicaciones + publicacionesPorPagina, publicaciones.length)} de {publicaciones.length} publicaciones
                </p>
                
                <!-- Research Projects Container -->
                <div class="results-grid grid grid-cols-1 md:grid-cols-2 gap-8" data-results-grid>
                    {investigaciones.map((investigacion) => (
                        <div class="research-card research-hover bg-white/90 backdrop-blur-sm p-6 rounded-xl shadow-lg border border-white/30 hover:border-daisy_bush-200 group">
                            <div class="flex items-start space-x-4">
                                <div class="text-3xl group-hover:scale-110 transition-transform duration-300">📄</div>
                                <div class="flex-1">
                                    <h3 class="text-lg font-semibold mb-2 text-cod_gray-900 group-hover:text-daisy_bush-700 transition-colors">
                                        {investigacion.titulo}
                                    </h3>
                                    <p class="text-sm text-cod_gray-600 mb-2 font-medium">
                                        {investigacion.categoria} | {investigacion.año_inicio}
                                    </p>
                                    <p class="text-cod_gray-700 text-sm leading-relaxed mb-4">
                                        {investigacion.descripcion}
                                    </p>
                                    <div class="flex flex-wrap gap-2 mb-4">
                                        {investigacion.tecnologias.map((tech) => (
                                            <span class="tech-badge bg-cod_gray-100 text-cod_gray-800 px-3 py-1 rounded-full text-xs font-medium border border-cod_gray-300/30">
                                                {tech}
                                            </span>
                                        ))}
                                    </div>
                                    <div class="flex items-center justify-between flex-wrap gap-2">
                                        {/* Badge DOI: solo si existe, siempre enlaza a doi.org */}
                                        {investigacion.doi && (
                                            <a
                                                href={`https://doi.org/${investigacion.doi}`}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="text-xs font-mono text-cod_gray-500 hover:text-daisy_bush-600 transition-colors truncate max-w-[180px]"
                                                title={`DOI: ${investigacion.doi}`}
                                            >
                                                DOI: {investigacion.doi}
                                            </a>
                                        )}
                                        {investigacion.url_detalles && (
                                            <a 
                                                href={investigacion.url_detalles}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                aria-label={`${investigacion.esBusqueda ? "Buscar" : "Abrir"} artículo ${investigacion.titulo} (abre en una pestaña nueva)`}
                                                class="text-daisy_bush-600 hover:text-daisy_bush-700 text-sm font-medium flex items-center gap-1 hover:gap-2 transition-all group-hover:translate-x-1"
                                            >
                                                {investigacion.esBusqueda ? "Buscar artículo" : "Abrir artículo"}
                                                <svg class="w-3 h-3 transition-transform group-hover:rotate-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                                </svg>
                                            </a>
                                        )}
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
                
                <Pagination currentPage={paginaActual} totalPages={totalPaginas} label="Páginas de publicaciones" hrefForPage={(pagina) => enlacePagina("pagina", pagina, "publicaciones")} />
            </div>
        </section>

        {productosScienti.map((seccion) => seccion.total > 0 && (
            <section id={seccion.parametro} class="relative bg-gradient-to-br from-cod_gray-50 to-white py-16 z-10 scroll-mt-24">
                <div class="max-w-[1140px] mx-auto px-10 relative">
                    <h2 class="text-3xl font-semibold text-center mb-12 text-cod_gray-900 hero-title">
                        {seccion.titulo}
                    </h2>

                    <p class="text-center text-cod_gray-700 mb-8">
                        Mostrando {seccion.inicio + 1}–{Math.min(seccion.inicio + publicacionesPorPagina, seccion.total)} de {seccion.total} {seccion.total === 1 ? "producto" : "productos"}
                    </p>

                    <div class="results-grid grid grid-cols-1 md:grid-cols-2 gap-8" data-results-grid>
                        {seccion.items.map((item) => (
                            <div class="research-card research-hover bg-white/90 backdrop-blur-sm p-6 rounded-xl shadow-lg border border-white/30 hover:border-daisy_bush-200 group">
                                <div class="flex items-start space-x-4">
                                    <div class="text-3xl group-hover:scale-110 transition-transform duration-300" aria-hidden="true">{seccion.icono}</div>
                                    <div class="flex-1">
                                        <h3 class="text-lg font-semibold mb-2 text-cod_gray-900 group-hover:text-daisy_bush-700 transition-colors">
                                            {item.titulo}
                                        </h3>
                                        <p class="text-sm text-cod_gray-600 mb-2 font-medium">
                                            {seccion.categoria} | {item.anio}
                                        </p>
                                        {item.autores && <p class="text-cod_gray-700 text-sm leading-relaxed mb-3">Autores: {item.autores}</p>}
                                        {item.detalle && <p class="text-cod_gray-700 text-sm leading-relaxed mb-4 break-words">{item.detalle}</p>}
                                        <div class="flex items-center justify-between flex-wrap gap-2">
                                            {item.doi && (
                                                <a
                                                    href={`https://doi.org/${item.doi}`}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="text-xs font-mono text-cod_gray-500 hover:text-daisy_bush-600 transition-colors truncate max-w-[180px]"
                                                    title={`DOI: ${item.doi}`}
                                                >
                                                    DOI: {item.doi}
                                                </a>
                                            )}
                                            <a
                                                href={item.url}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                aria-label={`${item.textoEnlace} ${item.titulo} (abre en una pestaña nueva)`}
                                                class="text-daisy_bush-600 hover:text-daisy_bush-700 text-sm font-medium flex items-center gap-1 hover:gap-2 transition-all group-hover:translate-x-1"
                                            >
                                                {item.textoEnlace}
                                                <svg class="w-3 h-3 transition-transform group-hover:rotate-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                                </svg>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>

                    <Pagination currentPage={seccion.paginaActual} totalPages={seccion.totalPaginas} label={`Páginas de ${seccion.titulo.toLowerCase()}`} hrefForPage={(pagina) => enlacePagina(seccion.parametro, pagina, seccion.parametro)} />
                </div>
            </section>
        ))}

        <!-- Call to Action -->
        <section class="bg-gradient-to-br from-daisy_bush-900 via-daisy_bush-800 to-Shiraz-900 text-cod_gray-50 py-16 relative overflow-hidden">
            <!-- Animated background -->
            <div class="absolute inset-0 opacity-5">
                <div class="floating-element absolute top-20 left-20 w-32 h-32 bg-Shiraz-400 rounded-full"></div>
                <div class="floating-element absolute bottom-20 right-20 w-24 h-24 bg-daisy_bush-400 rounded-full" style="animation-delay: -3s;"></div>
            </div>
            
            <div class="max-w-[1140px] mx-auto px-10 text-center relative z-10">
                <h2 class="text-3xl font-semibold mb-6 animate-fade-in-up">¿Interesado en colaborar?</h2>
                <p class="text-lg mb-8 max-w-2xl mx-auto opacity-90 animate-fade-in-up" style="animation-delay: 0.2s;">
                    Estamos abiertos a colaboraciones con otros grupos de investigación, 
                    instituciones educativas y organizaciones que compartan nuestros objetivos.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-in-up" style="animation-delay: 0.4s;">
                    <a href="/web/projects" class="inline-flex items-center gap-2 bg-gradient-to-r from-Shiraz-600 to-Shiraz-700 hover:from-Shiraz-700 hover:to-Shiraz-800 text-white px-6 py-3 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 hover:shadow-lg">
                        Ver Proyectos
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                        </svg>
                    </a>
                    <a href="mailto:cvieira@uninorte.edu.co" class="inline-flex items-center gap-2 border-2 border-cod_gray-50 hover:bg-cod_gray-50 hover:text-cod_gray-900 text-cod_gray-50 px-6 py-3 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 backdrop-blur-sm">
