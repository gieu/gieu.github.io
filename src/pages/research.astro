---
import BaseLayout from "../layouts/BaseLayout.astro";
import Pagination from "../components/Pagination.astro";
import { getCollection } from "astro:content";
import {
  SCIENTI_URL,
  obtenerSeccionesScienti,
} from "./api/publicaciones.json.ts";
import type { ScientiCatalogo } from "./api/publicaciones.json.ts";
import type { Publicacion as PublicacionApi } from "./api/publicaciones.json.ts";

const catalogoScienti = await obtenerSeccionesScienti();
const usandoRespaldo = catalogoScienti.publicaciones.length === 0;
const publicaciones: PublicacionApi[] = usandoRespaldo
  ? (await getCollection("researchs")).map(({ data }, index) => ({
      numero: String(index + 1),
      titulo: data.title,
      revista: data.journal,
      editorial: data.publisher,
      anio: String(data.year),
      autores: data.author.join("; "),
      doi: data.DOI ?? null,
      url: data.url,
    }))
  : catalogoScienti.publicaciones;

const publicacionesOrdenadas = [...publicaciones].sort(
  (a, b) => Number(b.anio ?? 0) - Number(a.anio ?? 0)
);
const publicacionesPorPagina = 6;
const enlacePagina = (parametro: string, pagina: number, seccion: string) => {
  const parametros = new URLSearchParams(Astro.url.searchParams);
  if (pagina === 1) parametros.delete(parametro);
  else parametros.set(parametro, String(pagina));
  const consulta = parametros.toString();
  const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
  const pathname = Astro.url.pathname.startsWith(`${basePath}/`) || Astro.url.pathname === basePath
    ? Astro.url.pathname
    : `${basePath}${Astro.url.pathname.startsWith("/") ? "" : "/"}${Astro.url.pathname}`;
  return `${pathname}${consulta ? `?${consulta}` : ""}#${seccion}`;
};
// Mapeamos al modelo que usa la UI de tarjetas.
const investigaciones = publicacionesOrdenadas.map((pub) => ({
  titulo: pub.titulo,
  categoria: pub.revista || "Publicación Scienti",
  año_inicio: pub.anio ?? "Sin año",
  descripcion: pub.autores ? `Autores: ${pub.autores}` : "Autores no disponibles",
  tecnologias: [pub.revista, pub.editorial].filter(Boolean) as string[],
  esBusqueda: !pub.doi && (!pub.url || pub.url === SCIENTI_URL),
  url_detalles: pub.doi
    ? pub.url ?? `https://doi.org/${pub.doi}`
    : pub.url && pub.url !== SCIENTI_URL
      ? pub.url
      : `https://scholar.google.com/scholar?q=${encodeURIComponent(pub.titulo)}`,
  doi: pub.doi,
}));

// Extraer lista única y limpia de autores de las publicaciones para el filtro
const autoresSet = new Set<string>();
publicaciones.forEach((pub) => {
  if (!pub.autores) return;
  const partes = pub.autores.includes(";")
    ? pub.autores.split(";")
    : pub.autores.split(",");

  partes.forEach((autorRaw) => {
    const autorLimpio = autorRaw
      .replace(/^[\s,;.]+|[\s,;.]+$/g, "")
      .replace(/\s+/g, " ");
    if (autorLimpio.length >= 3 && !/^(autores|et al\.?)$/i.test(autorLimpio)) {
      autoresSet.add(autorLimpio);
    }
  });
});
const listaAutores = Array.from(autoresSet).sort((a, b) =>
  a.localeCompare(b, "es", { sensitivity: "base" })
);

// Extraer rango dinámico de años
const aniosValidos = publicaciones
  .map((p) => parseInt(p.anio ?? "0", 10))
  .filter((a) => Number.isFinite(a) && a > 1990 && a <= new Date().getFullYear() + 1);

const anioMin = aniosValidos.length > 0 ? Math.min(...aniosValidos) : 2010;
const anioMax = aniosValidos.length > 0 ? Math.max(...aniosValidos) : new Date().getFullYear();

const capitulos = catalogoScienti.capitulosLibro;
const aniosCapitulos = capitulos.map((item) => Number(item.anio)).filter((anio) => anio > 1990 && anio <= new Date().getFullYear() + 1);
const minimoCapitulos = aniosCapitulos.length ? Math.min(...aniosCapitulos) : anioMin;
const maximoCapitulos = aniosCapitulos.length ? Math.max(...aniosCapitulos) : anioMax;
const busquedaCapitulos = Astro.url.searchParams.get("capitulos-busqueda") ?? "";
const leerAnioCapitulos = (parametro: string, defecto: number) => {
  const valor = Number(Astro.url.searchParams.get(parametro) ?? defecto);
  return Number.isSafeInteger(valor) ? Math.min(Math.max(valor, minimoCapitulos), maximoCapitulos) : defecto;
};
const desdeCapitulos = leerAnioCapitulos("capitulos-desde", minimoCapitulos);
const hastaCapitulos = Math.max(desdeCapitulos, leerAnioCapitulos("capitulos-hasta", maximoCapitulos));
const normalizarBusqueda = (texto: string) => texto.normalize("NFD").replace(/\p{Diacritic}/gu, "").toLowerCase().trim();
const palabrasCapitulos = normalizarBusqueda(busquedaCapitulos).split(/\s+/).filter(Boolean);
const capitulosFiltrados = capitulos.filter((item) => {
  const texto = normalizarBusqueda(`${item.titulo} ${item.autores ?? ""}`);
  const anio = Number(item.anio);
  return palabrasCapitulos.every((palabra) => texto.includes(palabra)) &&
    (!Number.isFinite(anio) || anio <= 0 ||
      ((desdeCapitulos === minimoCapitulos || anio >= desdeCapitulos) &&
       (hastaCapitulos === maximoCapitulos || anio <= hastaCapitulos)));
});
const limpiarCapitulos = new URL(Astro.url);
for (const parametro of ["capitulos", "capitulos-busqueda", "capitulos-desde", "capitulos-hasta"]) limpiarCapitulos.searchParams.delete(parametro);
limpiarCapitulos.hash = "capitulos";

const productosScienti = [
  { clave: "software", titulo: "Software", categoria: "Software", icono: "\u{1F4BB}", parametro: "software" },
  { clave: "capitulosLibro", titulo: "Capítulos de libro", categoria: "Capítulo de libro", icono: "\u{1F4D6}", parametro: "capitulos" },
  { clave: "librosPublicados", titulo: "Libros publicados", categoria: "Libro", icono: "\u{1F4DA}", parametro: "libros" },
  { clave: "librosFormacion", titulo: "Libros de formación", categoria: "Libro de formación", icono: "\u{1F4D8}", parametro: "formacion" },
  { clave: "librosDivulgacion", titulo: "Libros de divulgación", categoria: "Libro de divulgación", icono: "\u{1F4D7}", parametro: "divulgacion" },
  { clave: "otrosProductosTecnologicos", titulo: "Otros productos tecnológicos", categoria: "Producto tecnológico", icono: "\u2699", parametro: "tecnologia" },
].map((configuracion) => {
  const originales = catalogoScienti[configuracion.clave as keyof ScientiCatalogo];
  const todos = configuracion.clave === "capitulosLibro" ? capitulosFiltrados : originales;
  const totalPaginas = Math.max(1, Math.ceil(todos.length / publicacionesPorPagina));
  const solicitada = Number(Astro.url.searchParams.get(configuracion.parametro) ?? "1");
  const paginaActual = Number.isSafeInteger(solicitada) ? Math.min(Math.max(solicitada, 1), totalPaginas) : 1;
  const inicio = (paginaActual - 1) * publicacionesPorPagina;
  const items = todos.slice(inicio, inicio + publicacionesPorPagina).map((item) => ({
    ...item,
    anio: item.anio ?? "Sin año",
    detalle: "detalle" in item ? item.detalle : null,
    url: item.url ?? SCIENTI_URL,
    textoEnlace: "Ver detalles",
  }));
  return { ...configuracion, totalOriginal: originales.length, total: todos.length, totalPaginas, paginaActual, inicio, items };
});

---

<BaseLayout title="GIEU - Investigación" description="Conoce las líneas de investigación, publicaciones y productos académicos del Grupo de Investigación en Informática Educativa de la Universidad del Norte.">
    <style>
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }
        
        @keyframes floatReverse {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(20px); }
        }
        
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        @keyframes slideInLeft {
            from {
                opacity: 0;
                transform: translateX(-50px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }
        
        @keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(50px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }
        
        @keyframes scaleIn {
            from {
                opacity: 0;
                transform: scale(0.8);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }
        
        .results-grid.results-enter {
            animation: resultsEnter 0.28s ease-out both;
        }

        @keyframes resultsEnter {
            from { opacity: 0.5; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .area-card {
            animation: scaleIn 0.8s ease-out forwards;
            opacity: 0;
        }
        
        .area-card:nth-child(1) { animation-delay: 0.2s; }
        .area-card:nth-child(2) { animation-delay: 0.4s; }
        .area-card:nth-child(3) { animation-delay: 0.6s; }
        
        .hero-title {
            animation: fadeInUp 1s ease-out;
        }
        
        .hero-subtitle {
            animation: fadeInUp 1s ease-out 0.3s both;
        }
        
        .floating-bg {
            animation: float 6s ease-in-out infinite;
        }
        
        .floating-bg-reverse {
            animation: floatReverse 8s ease-in-out infinite;
        }
        
        .glass-morphism {
            backdrop-filter: blur(10px);
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        
        .research-hover {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .research-hover:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        }
        
        .tech-badge {
            transition: all 0.3s ease;
        }
        
        .tech-badge:hover {
            transform: scale(1.1);
        }
        
        .floating-element {
            animation: float 6s ease-in-out infinite;
        }
        
        .animate-fade-in-up {
            animation: fadeInUp 0.8s ease-out forwards;
        }

        @media (prefers-reduced-motion: reduce) {
            .research-page * {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }

            .area-card, .hero-title, .hero-subtitle,
            .floating-bg, .floating-bg-reverse, .floating-element,
            .animate-fade-in-up {
                animation: none !important;
                opacity: 1 !important;
            }

            .research-hover, .area-card, .tech-badge {
                transition: none !important;
            }

            .research-hover:hover, .area-card:hover, .tech-badge:hover {
                transform: none !important;
            }
        }
    </style>

    <main class="research-page min-h-screen relative overflow-hidden">
        <!-- Floating Background Elements -->
        <div class="fixed inset-0 overflow-hidden pointer-events-none z-0">
            <div class="floating-bg absolute top-20 left-10 w-32 h-32 bg-daisy_bush-300 opacity-10 rounded-full blur-xl"></div>
            <div class="floating-bg-reverse absolute top-40 right-20 w-48 h-48 bg-Shiraz-400 opacity-8 rounded-full blur-2xl"></div>
            <div class="floating-bg absolute bottom-32 left-1/4 w-40 h-40 bg-daisy_bush-200 opacity-12 rounded-full blur-xl"></div>
            <div class="floating-bg-reverse absolute top-1/3 right-1/3 w-24 h-24 bg-Shiraz-300 opacity-15 rounded-full blur-lg"></div>
            <div class="floating-bg absolute bottom-20 right-16 w-36 h-36 bg-daisy_bush-400 opacity-10 rounded-full blur-xl"></div>
        </div>

        <!-- Hero Section -->
        <section class="relative bg-gradient-to-br from-daisy_bush-900 via-daisy_bush-800 to-Shiraz-900 text-cod_gray-50 py-20 z-10">
            <div class="max-w-[1140px] mx-auto px-10 text-center relative">
                <!-- Glass morphism decoration -->
                <div class="glass-morphism absolute -top-10 -left-10 w-24 h-24 rounded-full opacity-30"></div>
                <div class="glass-morphism absolute -bottom-8 -right-12 w-32 h-32 rounded-full opacity-20"></div>
                
                <h1 class="hero-title text-4xl md:text-5xl font-bold mb-6">
                    Nuestras <span class="text-daisy_bush-300">Investigaciones</span>
                </h1>
                <p class="hero-subtitle text-xl md:text-2xl mb-8 leading-relaxed max-w-3xl mx-auto">
                    Desarrollamos investigación de vanguardia en educación STEM, 
                    tecnología educativa e inclusión para transformar la enseñanza y el aprendizaje.
                </p>
            </div>
        </section>

        <!-- Research Areas -->
        <section class="relative bg-gradient-to-br from-cod_gray-50 to-cod_gray-100 py-20 z-10">
            <div class="max-w-[1140px] mx-auto px-10 relative">
                <h2 class="text-3xl font-semibold text-center mb-12 text-cod_gray-900 hero-title">
                    Líneas de Investigación
                </h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
                    <!-- Research Area 1 -->
                    <div class="area-card bg-white/80 backdrop-blur-sm p-8 rounded-xl shadow-lg hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 border border-white/20">
                        <div class="text-5xl mb-6 text-center transform hover:scale-110 transition-transform duration-300">🔬</div>
                        <h3 class="text-xl font-semibold mb-4 text-cod_gray-900 text-center">
                            Metodologías STEM
                        </h3>
                        <p class="text-cod_gray-700 text-center leading-relaxed">
                            Desarrollo de enfoques pedagógicos innovadores para la enseñanza 
                            integrada de ciencias, tecnología, ingeniería y matemáticas.
                        </p>
                    </div>

                    <!-- Research Area 2 -->
                    <div class="area-card bg-white/80 backdrop-blur-sm p-8 rounded-xl shadow-lg hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 border border-white/20">
                        <div class="text-5xl mb-6 text-center transform hover:scale-110 transition-transform duration-300">💻</div>
                        <h3 class="text-xl font-semibold mb-4 text-cod_gray-900 text-center">
                            Tecnología Educativa
                        </h3>
                        <p class="text-cod_gray-700 text-center leading-relaxed">
                            Investigación en el uso efectivo de tecnologías emergentes 
                            para mejorar los procesos de enseñanza-aprendizaje.
                        </p>
                    </div>

                    <!-- Research Area 3 -->
                    <div class="area-card bg-white/80 backdrop-blur-sm p-8 rounded-xl shadow-lg hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 border border-white/20">
                        <div class="text-5xl mb-6 text-center transform hover:scale-110 transition-transform duration-300">🎯</div>
                        <h3 class="text-xl font-semibold mb-4 text-cod_gray-900 text-center">
                            Inclusión y Equidad
                        </h3>
                        <p class="text-cod_gray-700 text-center leading-relaxed">
                            Estudios sobre estrategias para promover la participación 
                            equitativa en la educación STEM.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Research Projects -->
        <section id="publicaciones" class="relative bg-gradient-to-br from-cod_gray-100 to-cod_gray-200 py-20 z-10 scroll-mt-24">
            <div class="max-w-[1140px] mx-auto px-10 relative">
                <!-- Decorative elements -->
                <div class="absolute top-10 right-10 w-20 h-20 bg-daisy_bush-200 opacity-20 rounded-full blur-xl floating-bg"></div>
                <div class="absolute bottom-10 left-10 w-16 h-16 bg-Shiraz-200 opacity-25 rounded-full blur-lg floating-bg-reverse"></div>
                
                <h2 class="text-3xl font-semibold text-center mb-8 text-cod_gray-900 hero-title">
                    Publicaciones Recientes
                </h2>

                {investigaciones.length > 0 && (
                    <!-- Panel de Búsqueda y Filtros Avanzados -->
                    <div class="bg-white/90 backdrop-blur-md p-6 md:p-8 rounded-2xl shadow-xl border border-white/40 mb-10">
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-end">
                            <!-- 1. Buscador por palabra clave -->
                            <div class="md:col-span-5">
                                <label for="filtro-busqueda" class="block text-sm font-semibold text-cod_gray-700 mb-2">
                                    Buscar por palabra clave:
                                </label>
                                <div class="relative">
                                    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-cod_gray-400">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                        </svg>
                                    </span>
                                    <input
                                        type="text"
                                        id="filtro-busqueda"
                                        placeholder="Ej: métodos mixtos, STEM, evaluación..."
                                        class="w-full pl-10 pr-10 py-2.5 bg-cod_gray-50 border border-cod_gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-daisy_bush-500 focus:bg-white transition-all text-cod_gray-800"
                                    />
                                    <button
                                        type="button"
                                        id="btn-limpiar-busqueda"
                                        class="hidden absolute inset-y-0 right-0 items-center pr-3 text-cod_gray-400 hover:text-cod_gray-600 focus:outline-none"
                                        title="Borrar texto"
                                    >
                                        ✕
                                    </button>
                                </div>
                            </div>

                            <!-- 2. Filtro por autor -->
                            <div class="md:col-span-4">
                                <label for="filtro-autor" class="block text-sm font-semibold text-cod_gray-700 mb-2">
                                    Filtrar por autor:
                                </label>
                                <select
                                    id="filtro-autor"
                                    class="w-full py-2.5 px-3 bg-cod_gray-50 border border-cod_gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-daisy_bush-500 focus:bg-white transition-all text-cod_gray-800"
                                >
                                    <option value="">Todos los autores ({listaAutores.length})</option>
                                    {listaAutores.map((autor) => (
                                        <option value={autor}>{autor}</option>
                                    ))}
                                </select>
                            </div>

                            <!-- 3. Filtro por Rango de Años con Slider -->
                            <div class="md:col-span-3">
                                <div class="grid grid-cols-2 gap-2">
                                    <div>
                                        <div class="flex justify-between text-xs text-cod_gray-500 mb-1">
                                            <span>Desde:</span>
                                            <span id="label-anio-desde" class="font-mono font-medium">{anioMin}</span>
                                        </div>
                                        <input
                                            type="range"
                                            id="filtro-anio-desde"
                                            min={anioMin}
                                            max={anioMax}
                                            value={anioMin}
                                            step="1"
                                            class="w-full accent-daisy_bush-600 cursor-pointer h-2 bg-cod_gray-200 rounded-lg appearance-none"
                                        />
                                    </div>
                                    <div>
                                        <div class="flex justify-between text-xs text-cod_gray-500 mb-1">
                                            <span>Hasta:</span>
                                            <span id="label-anio-hasta" class="font-mono font-medium">{anioMax}</span>
                                        </div>
                                        <input
                                            type="range"
                                            id="filtro-anio-hasta"
                                            min={anioMin}
                                            max={anioMax}
                                            value={anioMax}
                                            step="1"
                                            class="w-full accent-daisy_bush-600 cursor-pointer h-2 bg-cod_gray-200 rounded-lg appearance-none"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Barra de estado de filtros y contador -->
                        <div class="flex items-center justify-between mt-5 pt-4 border-t border-cod_gray-100 flex-wrap gap-3">
                            <div class="text-sm font-medium text-cod_gray-600">
                                Mostrando <span id="contador-publicaciones" class="font-bold text-daisy_bush-700">{investigaciones.length}</span> de <span class="font-bold">{investigaciones.length}</span> publicaciones
                            </div>
                            <button
                                id="btn-reset-filtros"
                                type="button"
                                class="text-xs font-semibold text-Shiraz-600 hover:text-Shiraz-800 hover:underline flex items-center gap-1 transition-colors"
                            >
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                                </svg>
                                Restablecer filtros
                            </button>
                        </div>
                    </div>
                )}
                
                <!-- Research Projects Container -->
                <div id="contenedor-publicaciones" class="grid grid-cols-1 md:grid-cols-2 gap-8 scroll-mt-24">
                    {investigaciones.map((investigacion) => (
                        <div
                            class="research-card research-hover bg-white/90 backdrop-blur-sm p-6 rounded-xl shadow-lg border border-white/30 hover:border-daisy_bush-200 group tarjeta-publicacion"
                            data-titulo={investigacion.titulo}
                            data-autores={investigacion.descripcion}
                            data-categoria={investigacion.categoria}
                            data-tecnologias={investigacion.tecnologias.join(" ")}
                            data-anio={investigacion.año_inicio}
                        >
                            <div class="flex items-start space-x-4">
                                <div class="text-3xl group-hover:scale-110 transition-transform duration-300">📄</div>
                                <div class="flex-1">
                                    <h3 class="text-lg font-semibold mb-2 text-cod_gray-900 group-hover:text-daisy_bush-700 transition-colors">
                                        {investigacion.titulo}
                                    </h3>
                                    <p class="text-sm text-cod_gray-600 mb-2 font-medium">
                                        {investigacion.categoria} | {investigacion.año_inicio}
                                    </p>
                                    <p class="text-cod_gray-700 text-sm leading-relaxed mb-4">
                                        {investigacion.descripcion}
                                    </p>
                                    <div class="flex flex-wrap gap-2 mb-4">
                                        {investigacion.tecnologias.map((tech) => (
                                            <span class="tech-badge bg-cod_gray-100 text-cod_gray-800 px-3 py-1 rounded-full text-xs font-medium border border-cod_gray-300/30">
                                                {tech}
                                            </span>
                                        ))}
                                    </div>
                                    <div class="flex items-center justify-between flex-wrap gap-2">
                                        {/* Badge DOI: solo si existe, siempre enlaza a doi.org */}
                                        {investigacion.doi && (
                                            <a
                                                href={`https://doi.org/${investigacion.doi}`}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="text-xs font-mono text-cod_gray-500 hover:text-daisy_bush-600 transition-colors truncate max-w-[180px]"
                                                title={`DOI: ${investigacion.doi}`}
                                            >
                                                DOI: {investigacion.doi}
                                            </a>
                                        )}
                                        {investigacion.url_detalles && (
                                            <a 
                                                href={investigacion.url_detalles}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                aria-label={`${investigacion.esBusqueda ? "Buscar" : "Abrir"} artículo ${investigacion.titulo} (abre en una pestaña nueva)`}
                                                class="text-daisy_bush-600 hover:text-daisy_bush-700 text-sm font-medium flex items-center gap-1 hover:gap-2 transition-all group-hover:translate-x-1"
                                            >
                                                {investigacion.esBusqueda ? "Buscar artículo" : "Abrir artículo"}
                                                <svg class="w-3 h-3 transition-transform group-hover:rotate-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                                </svg>
                                            </a>
                                        )}
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>

                <!-- Barra de Paginación -->
                <nav id="barra-paginacion" class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-10 pt-6 border-t border-cod_gray-200/70" aria-label="Paginación de publicaciones">
                    <div class="text-sm text-cod_gray-600 font-medium" id="info-paginacion">
                        Mostrando página <span id="pag-actual" class="font-bold text-daisy_bush-700">1</span> de <span id="pag-total" class="font-bold">1</span> (<span id="pag-rango" class="text-cod_gray-500">1-8</span> de <span id="pag-total-items" class="font-bold">{investigaciones.length}</span>)
                    </div>
                    <div class="flex items-center gap-1.5" id="controles-paginador">
                        <button
                            type="button"
                            id="btn-pag-anterior"
                            class="px-3.5 py-2 rounded-xl text-sm font-medium border border-cod_gray-200 bg-white hover:bg-daisy_bush-50 hover:text-daisy_bush-700 text-cod_gray-700 disabled:opacity-40 disabled:pointer-events-none transition-all shadow-sm flex items-center gap-1"
                            disabled
                        >
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                            </svg>
                            Anterior
                        </button>
                        <div id="contenedor-numeros-paginas" class="flex items-center gap-1">
                            <!-- Botones numéricos generados dinámicamente -->
                        </div>
                        <button
                            type="button"
                            id="btn-pag-siguiente"
                            class="px-3.5 py-2 rounded-xl text-sm font-medium border border-cod_gray-200 bg-white hover:bg-daisy_bush-50 hover:text-daisy_bush-700 text-cod_gray-700 disabled:opacity-40 disabled:pointer-events-none transition-all shadow-sm flex items-center gap-1"
                        >
                            Siguiente
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                            </svg>
                        </button>
                    </div>
                </nav>

                <!-- Estado vacío si ningún resultado coincide con los filtros -->
                <div id="estado-vacio-busqueda" class="hidden text-center py-16 bg-white/80 backdrop-blur-sm rounded-2xl shadow-md border border-white/40 mt-8">
                    <div class="text-5xl mb-3">🔍</div>
                    <h3 class="text-xl font-semibold text-cod_gray-900 mb-2">No se encontraron publicaciones</h3>
                    <p class="text-cod_gray-600 max-w-md mx-auto text-sm mb-5">
                        No hay artículos que coincidan con la búsqueda o los filtros seleccionados. Intenta con otros términos o amplía el rango de fechas.
                    </p>
                    <button
                        type="button"
                        id="btn-limpiar-filtros-vacio"
                        class="inline-flex items-center gap-2 bg-gradient-to-r from-daisy_bush-600 to-daisy_bush-700 hover:from-daisy_bush-700 hover:to-daisy_bush-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-all shadow hover:shadow-md"
                    >
                        Restablecer todos los filtros
                    </button>
                </div>
                
            </div>
        </section>

        {productosScienti.map((seccion) => seccion.totalOriginal > 0 && (
            <section id={seccion.parametro} class="relative bg-gradient-to-br from-cod_gray-50 to-white py-16 z-10 scroll-mt-24">
                <div class="max-w-[1140px] mx-auto px-10 relative">
                    <h2 class="text-3xl font-semibold text-center mb-12 text-cod_gray-900 hero-title">
                        {seccion.titulo}
                    </h2>

                    {seccion.clave === "capitulosLibro" && (
                        <form method="get" action={`${Astro.url.pathname}#capitulos`} class="mb-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4 items-end rounded-xl border border-cod_gray-200 bg-white p-5">
                            {Array.from(Astro.url.searchParams).filter(([nombre]) => !["capitulos", "capitulos-busqueda", "capitulos-desde", "capitulos-hasta"].includes(nombre)).map(([nombre, valor]) => <input type="hidden" name={nombre} value={valor} />)}
                            <label class="text-sm font-semibold text-cod_gray-700">Buscar por título o autor
                                <input type="search" name="capitulos-busqueda" value={busquedaCapitulos} placeholder="Título o autor" class="mt-2 w-full rounded-lg border border-cod_gray-300 px-3 py-2 font-normal" />
                            </label>
                            <label class="text-sm font-semibold text-cod_gray-700">Desde: <span id="capitulos-desde-valor">{desdeCapitulos}</span>
                                <input type="range" name="capitulos-desde" min={minimoCapitulos} max={maximoCapitulos} value={desdeCapitulos} step="1" class="mt-2 w-full accent-daisy_bush-600" />
                            </label>
                            <label class="text-sm font-semibold text-cod_gray-700">Hasta: <span id="capitulos-hasta-valor">{hastaCapitulos}</span>
                                <input type="range" name="capitulos-hasta" min={minimoCapitulos} max={maximoCapitulos} value={hastaCapitulos} step="1" class="mt-2 w-full accent-daisy_bush-600 cursor-pointer h-2 bg-cod_gray-200 rounded-lg appearance-none" />
                            </label>
                            <div class="flex items-center gap-4">
                                <button type="submit" class="rounded-lg bg-daisy_bush-600 px-4 py-2 font-semibold text-white hover:bg-daisy_bush-700">Filtrar</button>
                                <a href={`${limpiarCapitulos.pathname}${limpiarCapitulos.search}#capitulos`} class="text-sm text-daisy_bush-700 underline">Limpiar</a>
                            </div>
                        </form>
                    )}
                    <p class="text-center text-cod_gray-700 mb-8">
                        Mostrando {seccion.total ? seccion.inicio + 1 : 0}–{Math.min(seccion.inicio + publicacionesPorPagina, seccion.total)} de {seccion.total} {seccion.total === 1 ? "producto" : "productos"}
                    </p>
                    {seccion.total === 0 && <p class="text-center text-cod_gray-600 mb-8">No hay capítulos que coincidan con los filtros seleccionados.</p>}

                    <div class="results-grid grid grid-cols-1 md:grid-cols-2 gap-8" data-results-grid>
                        {seccion.items.map((item) => (
                            <div class="research-card research-hover bg-white/90 backdrop-blur-sm p-6 rounded-xl shadow-lg border border-white/30 hover:border-daisy_bush-200 group">
                                <div class="flex items-start space-x-4">
                                    <div class="text-3xl group-hover:scale-110 transition-transform duration-300" aria-hidden="true">{seccion.icono}</div>
                                    <div class="flex-1">
                                        <h3 class="text-lg font-semibold mb-2 text-cod_gray-900 group-hover:text-daisy_bush-700 transition-colors">
                                            {item.titulo}
                                        </h3>
                                        <p class="text-sm text-cod_gray-600 mb-2 font-medium">
                                            {seccion.categoria} | {item.anio}
                                        </p>
                                        {item.autores && <p class="text-cod_gray-700 text-sm leading-relaxed mb-3">Autores: {item.autores}</p>}
                                        {item.detalle && <p class="text-cod_gray-700 text-sm leading-relaxed mb-4 break-words">{item.detalle}</p>}
                                        <div class="flex items-center justify-between flex-wrap gap-2">
                                            {item.doi && (
                                                <a
                                                    href={`https://doi.org/${item.doi}`}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="text-xs font-mono text-cod_gray-500 hover:text-daisy_bush-600 transition-colors truncate max-w-[180px]"
                                                    title={`DOI: ${item.doi}`}
                                                >
                                                    DOI: {item.doi}
                                                </a>
                                            )}
                                            <a
                                                href={item.url}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                aria-label={`${item.textoEnlace} ${item.titulo} (abre en una pestaña nueva)`}
                                                class="text-daisy_bush-600 hover:text-daisy_bush-700 text-sm font-medium flex items-center gap-1 hover:gap-2 transition-all group-hover:translate-x-1"
                                            >
                                                {item.textoEnlace}
                                                <svg class="w-3 h-3 transition-transform group-hover:rotate-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                                </svg>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>

                    <Pagination currentPage={seccion.paginaActual} totalPages={seccion.totalPaginas} label={`Páginas de ${seccion.titulo.toLowerCase()}`} hrefForPage={(pagina) => enlacePagina(seccion.parametro, pagina, seccion.parametro)} />
                </div>
            </section>
        ))}

        <!-- Call to Action -->
        <section class="bg-gradient-to-br from-daisy_bush-900 via-daisy_bush-800 to-Shiraz-900 text-cod_gray-50 py-16 relative overflow-hidden">
            <!-- Animated background -->
            <div class="absolute inset-0 opacity-5">
                <div class="floating-element absolute top-20 left-20 w-32 h-32 bg-Shiraz-400 rounded-full"></div>
                <div class="floating-element absolute bottom-20 right-20 w-24 h-24 bg-daisy_bush-400 rounded-full" style="animation-delay: -3s;"></div>
            </div>
            
            <div class="max-w-[1140px] mx-auto px-10 text-center relative z-10">
                <h2 class="text-3xl font-semibold mb-6 animate-fade-in-up">¿Interesado en colaborar?</h2>
                <p class="text-lg mb-8 max-w-2xl mx-auto opacity-90 animate-fade-in-up" style="animation-delay: 0.2s;">
                    Estamos abiertos a colaboraciones con otros grupos de investigación, 
                    instituciones educativas y organizaciones que compartan nuestros objetivos.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-in-up" style="animation-delay: 0.4s;">
                    <a href="/web/projects" class="inline-flex items-center gap-2 bg-gradient-to-r from-Shiraz-600 to-Shiraz-700 hover:from-Shiraz-700 hover:to-Shiraz-800 text-white px-6 py-3 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 hover:shadow-lg">
                        Ver Proyectos
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                        </svg>
                    </a>
                    <a href="mailto:cvieira@uninorte.edu.co" class="inline-flex items-center gap-2 border-2 border-cod_gray-50 hover:bg-cod_gray-50 hover:text-cod_gray-900 text-cod_gray-50 px-6 py-3 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 backdrop-blur-sm">
                        Contáctanos
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                        </svg>
                    </a>
                </div>
            </div>
        </section>
    </main>

    <script>
        function inicializarFiltroPublicaciones() {
            for (const nombre of ["capitulos-desde", "capitulos-hasta"]) {
                const control = document.querySelector<HTMLInputElement>(`input[name="${nombre}"]`);
                const etiqueta = document.getElementById(`${nombre}-valor`);
                control?.addEventListener("input", () => {
                    if (etiqueta) etiqueta.textContent = control.value;
                });
            }
            const inputBusqueda = document.getElementById("filtro-busqueda") as HTMLInputElement | null;
            const btnLimpiar = document.getElementById("btn-limpiar-busqueda") as HTMLButtonElement | null;
            const selectAutor = document.getElementById("filtro-autor") as HTMLSelectElement | null;
            const sliderDesde = document.getElementById("filtro-anio-desde") as HTMLInputElement | null;
            const sliderHasta = document.getElementById("filtro-anio-hasta") as HTMLInputElement | null;
            const labelDesde = document.getElementById("label-anio-desde");
            const labelHasta = document.getElementById("label-anio-hasta");
            const contadorEl = document.getElementById("contador-publicaciones");
            const estadoVacio = document.getElementById("estado-vacio-busqueda");
            const btnReset = document.getElementById("btn-reset-filtros");
            const btnLimpiarVacio = document.getElementById("btn-limpiar-filtros-vacio");
            const contenedorPublicaciones = document.getElementById("contenedor-publicaciones");

            // Elementos de paginación
            const barraPaginacion = document.getElementById("barra-paginacion");
            const pagActualEl = document.getElementById("pag-actual");
            const pagTotalEl = document.getElementById("pag-total");
            const pagRangoEl = document.getElementById("pag-rango");
            const pagTotalItemsEl = document.getElementById("pag-total-items");
            const btnPagAnterior = document.getElementById("btn-pag-anterior") as HTMLButtonElement | null;
            const btnPagSiguiente = document.getElementById("btn-pag-siguiente") as HTMLButtonElement | null;
            const contenedorNumeros = document.getElementById("contenedor-numeros-paginas");

            const ELEMENTOS_POR_PAGINA = 8;
            let paginaActual = 1;
            let elementosFiltrados: HTMLElement[] = [];

            const tarjetas = Array.from(document.querySelectorAll<HTMLElement>(".tarjeta-publicacion"));
            if (tarjetas.length === 0) return;

            // Función para normalizar texto (sin tildes, minúsculas, espacios colapsados)
            function normalizar(texto: string): string {
                return (texto || "")
                    .toLowerCase()
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .replace(/[^\p{L}\p{N}\s]/gu, " ")
                    .replace(/\s+/g, " ")
                    .trim();
            }

            // Normalizamos de antemano el contenido indexable de cada tarjeta para rendimiento óptimo
            const tarjetasIndexadas = tarjetas.map((tarjeta) => {
                const titulo = normalizar(tarjeta.dataset.titulo || "");
                const autores = normalizar(tarjeta.dataset.autores || "");
                const categoria = normalizar(tarjeta.dataset.categoria || "");
                const tecnologias = normalizar(tarjeta.dataset.tecnologias || "");
                const textoCompleto = `${titulo} ${autores} ${categoria} ${tecnologias}`;
                const anio = parseInt(tarjeta.dataset.anio || "", 10);

                return {
                    elemento: tarjeta,
                    autores,
                    textoCompleto,
                    anio: Number.isFinite(anio) && anio > 0 ? anio : null,
                };
            });

            function renderizarPagina(hacerScroll = false) {
                const totalItems = elementosFiltrados.length;
                const totalPaginas = Math.ceil(totalItems / ELEMENTOS_POR_PAGINA) || 1;

                if (paginaActual > totalPaginas) paginaActual = totalPaginas;
                if (paginaActual < 1) paginaActual = 1;

                const inicio = (paginaActual - 1) * ELEMENTOS_POR_PAGINA;
                const fin = Math.min(inicio + ELEMENTOS_POR_PAGINA, totalItems);

                // Ocultar todas las tarjetas
                tarjetas.forEach((tarjeta) => tarjeta.classList.add("hidden"));

                // Mostrar únicamente las de la página actual
                for (let i = inicio; i < fin; i++) {
                    elementosFiltrados[i]?.classList.remove("hidden");
                }

                // Actualizar textos de paginación
                if (pagActualEl) pagActualEl.textContent = String(paginaActual);
                if (pagTotalEl) pagTotalEl.textContent = String(totalPaginas);
                if (pagRangoEl) pagRangoEl.textContent = totalItems > 0 ? `${inicio + 1}-${fin}` : "0";
                if (pagTotalItemsEl) pagTotalItemsEl.textContent = String(totalItems);

                // Actualizar estado de botones Anterior / Siguiente
                if (btnPagAnterior) btnPagAnterior.disabled = paginaActual <= 1;
                if (btnPagSiguiente) btnPagSiguiente.disabled = paginaActual >= totalPaginas;

                // Renderizar botones de número de página
                if (contenedorNumeros) {
                    contenedorNumeros.innerHTML = "";
                    if (totalPaginas > 1) {
                        for (let p = 1; p <= totalPaginas; p++) {
                            if (p === 1 || p === totalPaginas || Math.abs(p - paginaActual) <= 1) {
                                const btn = document.createElement("button");
                                btn.type = "button";
                                btn.textContent = String(p);
                                btn.className = p === paginaActual
                                    ? "w-9 h-9 rounded-xl text-sm font-bold bg-daisy_bush-600 text-white shadow-md transition-all"
                                    : "w-9 h-9 rounded-xl text-sm font-medium border border-cod_gray-200 bg-white text-cod_gray-700 hover:bg-daisy_bush-50 hover:text-daisy_bush-700 transition-all";
                                btn.addEventListener("click", () => {
                                    paginaActual = p;
                                    renderizarPagina(true);
                                });
                                contenedorNumeros.appendChild(btn);
                            } else if (
                                (p === 2 && paginaActual > 3) ||
                                (p === totalPaginas - 1 && paginaActual < totalPaginas - 2)
                            ) {
                                const span = document.createElement("span");
                                span.textContent = "...";
                                span.className = "px-1 text-cod_gray-400 font-bold select-none text-xs";
                                contenedorNumeros.appendChild(span);
                            }
                        }
                    }
                }

                // Mostrar u ocultar barra de paginación y estado vacío
                if (barraPaginacion) {
                    barraPaginacion.classList.toggle("hidden", totalItems <= ELEMENTOS_POR_PAGINA);
                }
                if (estadoVacio) {
                    estadoVacio.classList.toggle("hidden", totalItems > 0);
                }

                if (hacerScroll && contenedorPublicaciones) {
                    contenedorPublicaciones.scrollIntoView({ behavior: "smooth", block: "start" });
                }
            }

            function filtrar() {
                const terminoBusqueda = normalizar(inputBusqueda?.value || "");
                const autorSeleccionado = normalizar(selectAutor?.value || "");
                let anioDesde = parseInt(sliderDesde?.value || "0", 10);
                let anioHasta = parseInt(sliderHasta?.value || "9999", 10);

                // Asegurar que 'desde' no sea mayor que 'hasta'
                if (anioDesde > anioHasta) {
                    if (document.activeElement === sliderDesde && sliderHasta) {
                        sliderHasta.value = String(anioDesde);
                        anioHasta = anioDesde;
                    } else if (sliderDesde) {
                        sliderDesde.value = String(anioHasta);
                        anioDesde = anioHasta;
                    }
                }

                // Actualizar etiquetas visuales de los sliders
                const sinLimiteInferior = anioDesde === Number(sliderDesde?.min);
                const sinLimiteSuperior = anioHasta === Number(sliderHasta?.max);
                const textoDesde = String(anioDesde);
                const textoHasta = String(anioHasta);
                if (labelDesde) labelDesde.textContent = textoDesde;
                if (labelHasta) labelHasta.textContent = textoHasta;

                // Mostrar / ocultar botón 'X' de limpiar búsqueda
                if (btnLimpiar) {
                    btnLimpiar.classList.toggle("hidden", terminoBusqueda.length === 0);
                    btnLimpiar.classList.toggle("flex", terminoBusqueda.length > 0);
                }

                // Palabras clave individuales (para búsquedas como "métodos mixtos")
                const palabrasClave = terminoBusqueda.split(" ").filter((p) => p.length > 0);

                elementosFiltrados = [];

                tarjetasIndexadas.forEach((item) => {
                    const coincidePalabras = palabrasClave.length === 0 ||
                        palabrasClave.every((palabra) => item.textoCompleto.includes(palabra));
                    const coincideAutor = !autorSeleccionado || item.autores.includes(autorSeleccionado);
                    const coincideAnio = item.anio === null || ((sinLimiteInferior || item.anio >= anioDesde) && (sinLimiteSuperior || item.anio <= anioHasta));

                    if (coincidePalabras && coincideAutor && coincideAnio) {
                        elementosFiltrados.push(item.elemento);
                    }
                });

                if (contadorEl) {
                    contadorEl.textContent = String(elementosFiltrados.length);
                }

                // Al cambiar filtros, regresar a la página 1
                paginaActual = 1;
                renderizarPagina(false);
            }

            function restablecerFiltros() {
                if (inputBusqueda) inputBusqueda.value = "";
                if (selectAutor) selectAutor.value = "";
                if (sliderDesde) sliderDesde.value = sliderDesde.min;
                if (sliderHasta) sliderHasta.value = sliderHasta.max;
                filtrar();
                inputBusqueda?.focus();
            }

            inputBusqueda?.addEventListener("input", filtrar);
            selectAutor?.addEventListener("change", filtrar);
            sliderDesde?.addEventListener("input", filtrar);
            sliderHasta?.addEventListener("input", filtrar);

            btnLimpiar?.addEventListener("click", () => {
                if (inputBusqueda) inputBusqueda.value = "";
                filtrar();
                inputBusqueda?.focus();
            });

            btnReset?.addEventListener("click", restablecerFiltros);
            btnLimpiarVacio?.addEventListener("click", restablecerFiltros);

            btnPagAnterior?.addEventListener("click", () => {
                if (paginaActual > 1) {
                    paginaActual--;
                    renderizarPagina(true);
                }
            });

            btnPagSiguiente?.addEventListener("click", () => {
                const totalPaginas = Math.ceil(elementosFiltrados.length / ELEMENTOS_POR_PAGINA);
                if (paginaActual < totalPaginas) {
                    paginaActual++;
                    renderizarPagina(true);
                }
            });

            // Inicializar primera carga paginada
            filtrar();
        }

        // Ejecutar en la carga y soportar navegación con View Transitions de Astro
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", inicializarFiltroPublicaciones);
        } else {
            inicializarFiltroPublicaciones();
        }
        document.addEventListener("astro:page-load", inicializarFiltroPublicaciones);
    </script>
</BaseLayout>
