---
import BaseLayout from "../layouts/BaseLayout.astro";
import LeadersSection from "../components/TeamPage/LeadersSection.astro";
import MembersGrid from "../components/TeamPage/MembersGrid.astro";
import { leaders, members } from "../utils/peopleInfo";
---

<BaseLayout title="Equipo - GIEU - Grupo de Investigación en Informática Educativa">

    <main class="bg-white">

        <!-- Team Hero Section -->
    <section
        class="relative isolate mb-14 min-h-[400px] overflow-hidden bg-gradient-to-br from-daisy_bush-900 via-daisy_bush-800 to-Shiraz-800 text-cod_gray-50"
        aria-labelledby="team-title"
    >
        <!-- Decorative background circles -->
        <div
            class="absolute -left-20 -top-16 h-64 w-64 rounded-full bg-daisy_bush-400/20 blur-3xl"
            aria-hidden="true"
        ></div>

        <div
            class="absolute -right-24 top-16 h-80 w-80 rounded-full bg-Shiraz-400/20 blur-3xl"
            aria-hidden="true"
        ></div>

        <div
            class="absolute bottom-[-100px] left-1/4 h-72 w-72 rounded-full bg-daisy_bush-300/15 blur-3xl"
            aria-hidden="true"
        ></div>

        <div
            class="absolute bottom-10 right-1/4 h-32 w-32 rounded-full bg-Shiraz-300/20 blur-2xl"
            aria-hidden="true"
        ></div>

        <!-- Subtle glass decorations -->
        <div
            class="absolute left-[12%] top-24 h-20 w-20 rounded-full border border-white/20 bg-white/10 backdrop-blur-sm"
            aria-hidden="true"
        ></div>

        <div
            class="absolute bottom-20 right-[12%] h-28 w-28 rounded-full border border-white/10 bg-white/10 backdrop-blur-sm"
            aria-hidden="true"
        ></div>

        <!-- Hero content -->
        <div class="relative z-10 mx-auto flex min-h-[400px] max-w-[1140px] items-center justify-center px-6 py-6 text-center sm:px-10">
            <div class="max-w-3xl animate-fade-in">
                <h1
                    id="team-title"
                    class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl md:text-6xl"
                >
                    Conoce a nuestro equipo
                </h1>

                <p class="mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-cod_gray-200 sm:text-xl">
                    Conoce a las personas que hacen posible nuestro trabajo, investigación e innovación educativa.
                </p>
            </div>
        </div>
    </section>

        <!-- Team leaders section -->
        <LeadersSection leaders={leaders} />

        <!-- Members Grid Section -->
        <MembersGrid members={members} />

    </main>

    <style>
        @keyframes fade-in {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-fade-in {
            animation: fade-in 1s ease-out;
        }

        @media (prefers-reduced-motion: reduce) {
            .animate-fade-in {
                animation: none;
            }
        }
    </style>
</BaseLayout>