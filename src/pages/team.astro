---
import BaseLayout from "../layouts/BaseLayout.astro";
import LeadersSection from "../components/TeamPage/LeadersSection.astro";
import MembersGrid from "../components/TeamPage/MembersGrid.astro";
import { leaders, members } from "../utils/peopleInfo";
---

<BaseLayout title="Equipo - GIEU - Grupo de Investigación en Informática Educativa">

    <main class="bg-white">

        <!-- Team Header Section -->
        <section
            class="flex items-center justify-center px-6 py-24 md:py-40"
            aria-labelledby="team-title"
        >
            <h1
                id="team-title"
                class="animate-fade-in bg-gradient-to-r from-red-400 via-pink-500 to-purple-600 bg-clip-text text-center text-5xl font-bold tracking-tight text-transparent md:text-6xl"
	        >
                Conoce a nuestro equipo
            </h1>
        </section>

        <!-- Team leaders section -->
        <LeadersSection leaders={leaders} />

        <!-- Members Grid Section -->
        <MembersGrid members={members} />

    </main>

    <style>
        @keyframes fade-in {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-fade-in {
            animation: fade-in 1s ease-out;
        }

        @media (prefers-reduced-motion: reduce) {
            .animate-fade-in {
                animation: none;
            }
        }
    </style>
</BaseLayout>