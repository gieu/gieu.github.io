---
import type { Person } from '../../utils/peopleInfo';

interface Props {
  leader: Person;
}

const { leader } = Astro.props;
---

<!-- Leader card -->
<article class="flex flex-col gap-14 md:flex-row md:items-center">

  <!-- Leader image composition -->
  <div class="relative mx-auto h-80 w-64 shrink-0 overflow-x-hidden md:mx-0 md:h-[400px] md:w-[300px]">

    <!-- Gradient background -->
    <div
      class="absolute inset-x-0 bottom-0 h-64 bg-gradient-to-br from-Shiraz-500 to-daisy_bush-600 opacity-90 md:h-80"
      aria-hidden="true"
    >
    </div>

    <!-- Show the leader photo when available -->
    {leader.photo ? (
      <img
        src={leader.photo}
        alt={`Photo of ${leader.name}`}
        class="absolute bottom-0 left-1/2 z-10 h-80 w-auto max-w-none -translate-x-1/2 md:h-[400px]"
        loading="lazy"
      />
    ) : (

      <!-- Fallback shown when the photo is missing -->
      <div
        class="absolute inset-x-0 bottom-0 z-10 flex h-56 items-center justify-center rounded-2xl shadow-md md:h-64"
        aria-label={`Photo of ${leader.name} not available`}
      >
        <!-- Display the first letter of the leader's name -->
        <span class="font-Lato text-4xl font-bold text-white/90">
          {leader.name.charAt(0)}
        </span>
      </div>
    )}
  </div>

  <!-- Leader description and identification -->
  <div class="flex w-full flex-col items-center gap-5 whitespace-pre-line md:-translate-y-5 md:items-start">

    <!-- Render the description only when it exists -->
    {leader.description && (
      <div class="flex min-h-[160px] w-full items-center justify-center bg-cod_gray-100 px-8 pb-7 text-start text-xl leading-normal text-cod_gray-950">
        <p>{leader.description}</p>
      </div>
    )}

    <!-- Leader name and role -->
    <div class="space-y-2 px-8">
      <h2 class="text-xl font-bold leading-normal text-daisy_bush-700">
        {leader.name}
      </h2>

      <p class="text-base font-bold leading-normal text-cod_gray-700">
        {leader.role}
      </p>
    </div>
  </div>
</article>